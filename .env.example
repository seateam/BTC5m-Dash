# Polymarket 私钥（首次运行时用于生成 API 凭证，生成后可删除）
POLYMARKET_PRIVATE_KEY=0x你的私钥

# Polymarket 代理钱包地址（充值地址，可在 polymarket.com 账户页面找到）
POLYMARKET_PROXY_ADDRESS=0x你的代理钱包地址

# 签名模式：auto(默认 proxy，识别到 Safe 则用 Safe) / proxy(强制 Polymarket Proxy) / safe(强制 Safe) / eoa(强制 EOA) / 1271(合约钱包)
POLYMARKET_SIGNATURE_TYPE=auto

# 运行模式：full=带前端页面，headless=纯后端
APP_MODE=full

# 交易执行模式：paper=模拟盘（默认，不发真实订单） / live=真实盘
TRADING_MODE=paper

# 模拟盘参数
PAPER_INITIAL_USDC=1000
PAPER_LATENCY_MODE=dynamic
PAPER_MIN_LATENCY_MS=120
PAPER_MAX_LATENCY_MS=850
PAPER_DYNAMIC_MAX_LATENCY_MS=2500
PAPER_FAST_SETTLE_MIN_DIFF=1
PAPER_FAST_SETTLE_MAX_PRICE_AGE_MS=5000
PAPER_BOOK_AUDIT_LEVELS=5
PAPER_BOOK_WS_MAX_DIFF=0.08
PAPER_BOOK_CONFIRM_DELAY_MS=250
# 默认贴近真实盘：双边锁仓不提前 merge 释放 USDC，等结算/Auto Redeem。
PAPER_PRE_SETTLEMENT_MERGE_ENABLED=false
TERMINAL_BOOK_GUARD_ENABLED=true
TERMINAL_BOOK_GUARD_SECONDS=6
TERMINAL_BOOK_GUARD_DIFF=10
TERMINAL_BOOK_GUARD_WIN_MAX_ASK=0.7
MACD_FILTER_ENABLED=true
MACD_FILTER_REQUIRE_FAST_AGREE=true
MACD_FILTER_MIN_REMAINING=12
MACD_FILTER_STRONG_DIFF_BYPASS=120

# 监听地址（强烈建议本地使用默认 127.0.0.1；只有明确需要远程访问时才改成 0.0.0.0）
HOST=127.0.0.1

# 可选：开启后，所有写入接口（下单/改策略/回测开关）都需要鉴权
# 使用方式：请求头带 x-auth-token: <token> 或 Authorization: Bearer <token>
APP_AUTH_TOKEN=

# 自动 Claim 开关
AUTO_CLAIM_ENABLED=true

# 自动策略配置（默认全关闭，服务每次启动都按这里的值初始化）
STRATEGY_S1_ENABLED=false
STRATEGY_S1_AMOUNT=1
STRATEGY_S2_ENABLED=false
STRATEGY_S2_AMOUNT=1
STRATEGY_S3_ENABLED=false
STRATEGY_S3_AMOUNT=1
STRATEGY_S4_ENABLED=false
STRATEGY_S4_AMOUNT=1
STRATEGY_S5_ENABLED=false
STRATEGY_S5_AMOUNT=1
STRATEGY_S6_ENABLED=false
STRATEGY_S6_AMOUNT=1
STRATEGY_S7_ENABLED=false
STRATEGY_S7_AMOUNT=1
STRATEGY_S8_ENABLED=false
STRATEGY_S8_AMOUNT=1
STRATEGY_S9_ENABLED=false
STRATEGY_S9_AMOUNT=1

# 自动策略默认滑点
STRATEGY_S10_ENABLED=false
STRATEGY_S10_AMOUNT=20

# S10 full-set split/merge arbitrage scanner
S10_FULLSET_SCANNER_ENABLED=true
S10_FULLSET_REFRESH_MS=800
S10_FULLSET_MIN_PROFIT_PCT=5
S10_FULLSET_TRIGGER_PROFIT_PCT=6.5
S10_FULLSET_FEE_BUFFER_PCT=1.2
S10_FULLSET_MIN_SHARES=1
S10_FULLSET_MAX_BOOK_AGE_MS=1800
S10_MAKER_ENGINE_ENABLED=true
S10_MAKER_ONLY=true
S10_MAKER_MAX_ACTIVE_ORDERS_PER_SIDE=2
S10_MAKER_MIN_ACTIVE_MS=250
S10_MAKER_MAX_BOOK_AGE_MS=1800
S10_MAKER_PARTIAL_MIN_SHARES=0.5
S10_MAKER_DUPLICATE_PRICE_EPS=0.0125

# Live trading hard gates. Keep disabled until paper stats + small live canary pass.
LIVE_TRADING_ENABLED=false
LIVE_MAX_BOOK_STALE_MS=900
LIVE_BOOK_WS_MAX_DIFF=0.025
LIVE_BOOK_CONFIRM_DELAY_MS=160
LIVE_MIN_BUY_REMAINING_SEC=12
LIVE_MAX_ORDER_USDC=25
LIVE_STRATEGY_MAX_ORDER_USDC=12
LIVE_MAX_PRICE_IMPACT_PCT=0.35
LIVE_STRATEGY_ORDER_RETRIES=1
LIVE_STRATEGY_RETRY_DELAY_MS=350
S10_LIVE_MAKER_ENABLED=false
S10_LIVE_MAKER_MIN_REMAINING_SEC=4
S10_LIVE_MAKER_ORDER_SYNC_MS=2000

ORDER_DEFAULT_SLIPPAGE=0.05

# 下单 slippage 上限（防误操作；超过直接拒绝）
ORDER_MAX_SLIPPAGE=0.2
